# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Output of build.sh — the .app bundle is rebuilt from source
build/

# Generated by Tools/make_icon.sh; build.sh recreates it when missing
Resources/AppIcon.icns
Resources/PlateDocument.icns

# Xcode, if it is ever opened here
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS Finder metadata
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Editors
.vscode/
.idea/
*.swp

# Local working notes for future sessions — deliberately not published
HANDOFF.md

# The screenshot / click / fixture harness HANDOFF.md describes. Local tooling for
# verifying UI work on this machine, not part of the app.
Tools/verify/

# Scratch output the tests can be pointed at
*.plate
*.xlsx
*.csv
!Tests/**/*.csv

# Claude Code guidance and settings — local, like HANDOFF.md, deliberately not published
CLAUDE.md
.claude/

# Python port (python_port/): virtualenv, caches and build output — the package itself is committed
python_port/.venv/
python_port/dist/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# The port's cross-compatibility fixtures are deliberate example files, not experimental data
!python_port/tests/fixtures/**/*.plate
!python_port/tests/fixtures/**/*.csv
