<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>pLayout</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>plate</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>PlateDocument</string>
			<key>CFBundleTypeName</key>
			<string>Plate Layout</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.nettilor.playout</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>PLayout</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.nettilor.playout</string>
	<key>CFBundleName</key>
	<string>pLayout</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.5.1</string>
	<key>CFBundleVersion</key>
	<string>7</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<!-- Deliberately NOT public.json. A .plate file is JSON, but
			     conforming to public.json pulls in public.text, and macOS's own
			     TextThumbnailExtension then claims the type and renders the raw
			     JSON as the file's thumbnail and spacebar preview — overriding
			     the document icon at every Finder size that draws a preview.
			     public.data + public.content keeps the icon. (Measured Aug 25
			     2026; public.content on its own is harmless.) -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Plate Layout</string>
			<key>UTTypeIconFile</key>
			<string>PlateDocument</string>
			<key>UTTypeIdentifier</key>
			<string>com.nettilor.playout</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>plate</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
